# Copie para .env (worker) e apps/web/.env.local (web). Nunca versione valores reais.
# Valores locais são exibidos por: npx supabase status

# --- web (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only: usada apenas em src/lib/supabase/admin.ts (convites)
SUPABASE_SERVICE_ROLE_KEY=
MAX_UPLOAD_MB=20

# --- worker (.env na raiz, carregado pelo worker; ou variáveis do container) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET=documents
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=300
# consulta de CNAE e razão social (automação n8n, servidor MCP); vazio = CNAE/razão social digitados
CNPJ_LOOKUP_MCP_URL=
CNPJ_LOOKUP_TIMEOUT=20

# --- testes ---
# PDFs reais (com dados pessoais) ficam fora do Git
SAMPLES_DIR=docs/Amostras
